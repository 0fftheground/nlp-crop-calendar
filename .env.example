# --- LLM ---
LLM_PROVIDER=openai
OPENAI_API_BASE=https://api.gptsapi.net/v1
OPENAI_API_KEY=
EXTRACTOR_PROVIDER=openai
EXTRACTOR_MODEL=gpt-4.1-mini
EXTRACTOR_API_KEY=
EXTRACTOR_API_BASE=
EXTRACTOR_TEMPERATURE=0.0
INTENT_ROUTING_MODE=llm_only
INTENT_RULES_PATH=
INTENT_RULES_RELOAD_SECONDS=5

# --- Server ---
DEFAULT_REGION=global
FASTAPI_PORT=8000
HOST=0.0.0.0
FASTAPI_HOST=0.0.0.0
CHAINLIT_HOST=0.0.0.0
CHAINLIT_PORT=8001
PUBLIC_BASE_URL=

# --- Agronomy DB (use AGRI_DB_URL or the split fields below) ---
AGRI_DB_URL=
AGRI_DB_HOST=
AGRI_DB_PORT=5432
AGRI_DB_NAME=
AGRI_DB_USER=
AGRI_DB_PASSWORD=
AGRI_DB_SSLMODE=
DEFAULT_FARM_ID=
BUSINESS_API_BASE_URL=
BUSINESS_API_KEY=
PLANTING_PLAN_SEARCH_API_URL=
PLANTING_PLAN_ACTIVE_API_URL=
PLANTING_PLAN_DETAIL_API_URL=
FARM_WEATHER_API_URL=
SOWING_SUITABILITY_API_URL=
# Optional region lookup sources (JSON array); higher priority than defaults
# DB_REGION_LOOKUP_CANDIDATES='[{"table":"public.agri_region","id_column":"id","name_column":"name"}]'
DB_REGION_LOOKUP_CANDIDATES=
# Legacy table configs (still supported, not recommended)
# VARIETY_DB_TABLE=agri_rice_variety
# REGION_DB_TABLE=public.agri_region
# REGION_DB_ID_COLUMN=id
# REGION_DB_NAME_COLUMN=name

# --- Cache DB (pending/tool/interaction/geocode) ---
CACHE_DB_URL=

# --- Tools ---
VARIETY_PROVIDER=local
VARIETY_API_URL=
VARIETY_API_KEY=
GROWTH_STAGE_PROVIDER=local
GROWTH_STAGE_API_URL=
GROWTH_STAGE_API_KEY=
CROP_CALENDAR_PROVIDER=mock
CROP_CALENDAR_API_URL=
CROP_CALENDAR_API_KEY=
CROP_CALENDAR_SAVE_API_URL=
CROP_CALENDAR_DELETE_API_URL=

# --- Persistence / Cache ---
PENDING_STORE=postgres
PENDING_STORE_TTL_SECONDS=1800
PENDING_STORE_PATH=
TOOL_CACHE_STORE=postgres
TOOL_CACHE_TTL_SECONDS=3600
TOOL_CACHE_PATH=
TOOL_CACHE_MAX_ITEMS=512
INTERACTION_STORE=postgres
INTERACTION_STORE_TTL_DAYS=30
INTERACTION_STORE_PATH=
INTERACTION_STORE_MAX_ITEMS=2000
INTERACTION_RAW_MAX_CHARS=2000
INTERACTION_RAW_DIR=

# --- Chainlit Auth ---
CHAINLIT_AUTH_USERS=
CHAINLIT_AUTH_USERNAME=
CHAINLIT_AUTH_PASSWORD=
CHAINLIT_AUTH_SECRET=

# --- OpenTelemetry ---
OTEL_SERVICE_NAME=nlp-crop-calendar
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_RESOURCE_ATTRIBUTES=
# Collector output paths (used by scripts/run_otel_collector.ps1 if set)
OTEL_LOG_PATH=.cache/otel/otel-logs.json
OTEL_TRACES_PATH=.cache/otel/otel-traces.json
# Example for local collector:
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_EXPORTER_OTLP_INSECURE=true
