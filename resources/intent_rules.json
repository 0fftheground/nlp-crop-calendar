{
  "version": "2026-02-12",
  "rules": [
    {
      "id": "memory_clear",
      "action": "tool",
      "name": "memory_clear",
      "priority": 100,
      "regex": [
        "(清除|清空|删除|重置).*(记忆|历史|上下文)"
      ]
    },
    {
      "id": "non_agri_life_query",
      "action": "none",
      "priority": 95,
      "any": [
        "旅游",
        "旅行",
        "出游",
        "游玩",
        "景点",
        "酒店",
        "住宿",
        "机票",
        "航班",
        "高铁",
        "火车票",
        "出差",
        "通勤",
        "穿衣",
        "紫外线",
        "洗车"
      ]
    },
    {
      "id": "plant_plan_delete",
      "action": "tool",
      "name": "plant_plan_delete",
      "priority": 90,
      "any": [
        "删除计划",
        "移除计划",
        "删除种植计划",
        "取消计划"
      ],
      "regex": [
        "(?:plant_season_id|plan_id|计划id|计划编号|id)\\s*[:=]?\\s*(\\d+)"
      ]
    },
    {
      "id": "plant_plan_list_active",
      "action": "tool",
      "name": "plant_plan_list_active",
      "priority": 80,
      "any": [
        "查一下",
        "帮我查",
        "查看",
        "查询",
        "列出",
        "计划列表",
        "种植计划列表",
        "所有种植计划",
        "全部种植计划",
        "查询所有种植计划",
        "全部计划",
        "所有计划",
        "有哪些计划",
        "启用计划"
      ],
      "all": ["计划"],
      "regex": [
        "(查询|查看|列出|查一下|帮我查|帮忙查)?(所有|全部)?.*(种植计划|生产计划|计划)"
      ],
      "negative": [
        "生育期",
        "生长阶段",
        "成熟期"
      ]
    },
    {
      "id": "weather_suitability_lookup",
      "action": "tool",
      "name": "weather_lookup",
      "priority": 72,
      "any": [
        "适合施肥",
        "适宜施肥",
        "适合炼苗",
        "适宜炼苗",
        "适合移栽",
        "适宜移栽",
        "适合翻地",
        "适宜翻地",
        "适合打药",
        "适宜打药",
        "适合整地",
        "适宜整地",
        "适合收割",
        "适宜收割",
        "农事适宜度"
      ],
      "negative": [
        "播期",
        "播种适宜期",
        "种植计划",
        "生育期"
      ]
    },
    {
      "id": "weather_lookup",
      "action": "tool",
      "name": "weather_lookup",
      "priority": 70,
      "any": [
        "天气",
        "气象",
        "气温",
        "温度",
        "降雨",
        "降水",
        "湿度",
        "风速",
        "预报"
      ],
      "negative": [
        "农事",
        "种植",
        "方案",
        "计划",
        "生育期",
        "病虫",
        "施肥",
        "打药"
      ],
      "handler": "weather"
    },
    {
      "id": "sowing_suitability_lookup",
      "action": "tool",
      "name": "sowing_suitability_lookup",
      "priority": 65,
      "any": [
        "播期推荐",
        "播种适宜期",
        "播期",
        "播种",
        "适播",
        "适宜播种",
        "播种窗口",
        "什么时候播种",
        "何时播种",
        "什么时候播",
        "何时播"
      ],
      "regex": [
        "(什么时候|何时).*(播种|播)",
        "(播种|播).*(什么时候|何时)"
      ],
      "negative": [
        "天气",
        "气象",
        "生育期",
        "计划删除"
      ]
    },
    {
      "id": "growth_stage_lookup",
      "action": "tool",
      "name": "growth_stage_lookup",
      "priority": 60,
      "any": [
        "生育期",
        "生长阶段",
        "成熟期",
        "返青",
        "分蘖",
        "孕穗",
        "抽穗",
        "灌浆"
      ],
      "negative": [
        "品种",
        "审定",
        "抗性",
        "性状",
        "特性",
        "适应性"
      ]
    },
    {
      "id": "crop_calendar_workflow",
      "action": "workflow",
      "name": "crop_calendar_workflow",
      "priority": 50,
      "any": [
        "建立",
        "生成种植计划",
        "生成一个种植计划",
        "帮我生成种植计划",
        "帮我生成一个种植计划",
        "生成农事方案",
        "生成方案",
        "移栽方案",
        "种植方案"
      ],
      "regex": [
        "(创建|新增|新建|添加|生成|制定|建立).*(种植计划|生产计划|种植方案|栽培方案|管理方案|农事方案|移栽方案)"
      ]
    },
    {
      "id": "variety_lookup",
      "action": "tool",
      "name": "variety_lookup",
      "priority": 40,
      "any": [
        "品种",
        "审定",
        "抗性",
        "性状",
        "特性",
        "成熟期",
        "熟期",
        "适应性"
      ]
    }
  ]
}
